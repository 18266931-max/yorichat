{
  "buildCommand": "npm run build",
  "devCommand": "node server.prod.js",
  "installCommand": "npm install",
  "functions": {
    "server.prod.js": {
      "runtime": "@vercel/node@3.2.14"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.prod.js"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/$1",
      "headers": {
        "Cache-Control": "max-age=86400"
      }
    },
    {
      "src": "/",
      "dest": "/dist/index.html"
    }
  ]
}
